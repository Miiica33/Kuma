# 火山引擎方舟 API（与官方 curl 一致）
# 鉴权：Bearer Token，支持 ARK_API_KEY 或 VOLCANO_API_KEY
ARK_API_KEY=your_ark_api_key_here
# 可选，默认如下
# VOLCANO_API_ENDPOINT=https://ark.cn-beijing.volces.com
# VOLCANO_MODEL=doubao-seed-1-8-251228

# WebSocket 配置
WS_HOST=0.0.0.0
WS_PORT=8000

# 日志配置（便于排查问题）
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# 前端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:8000

# ASR：本地 SenseVoiceSmall 模型目录，不填则使用 backend/models/SenseVoiceSmall
# 识别过程与问题请查看后端日志中 [ASR] 开头的记录
# ASR_MODEL_DIR=./models/SenseVoiceSmall
# ASR 调试：设为 true 时把每次识别的 WAV 保存到 backend/asr_debug_last.wav，可播放确认是否录到人声
# ASR_DEBUG_SAVE_WAV=false
